{
  "name": "lumina-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-blog-json.mjs && next dev",
    "dev:cms": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:cms\"",
    "build": "node scripts/build-blog-json.mjs && next build",
    "images:webp": "node scripts/convert-images-to-webp.mjs",
    "images:webp:replace": "node scripts/convert-images-to-webp.mjs --replace",
    "lint": "eslint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "express": "^4.19.2",
    "gsap": "^3.15.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.2.0",
    "netlify-cms-proxy-server": "^1.3.24",
    "next": "16.2.9",
    "postcss": "^8.4.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite3": "^5.1.6",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "puppeteer": "^22.12.1",
    "sharp": "^0.33.5",
    "typescript": "^5"
  }
}
